# FinSense Backend Configuration

# Application
APP_NAME=FinSense
DEBUG=false

# Database: SQLite default, or set to your Supabase PostgreSQL connection string
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=sqlite:///./finsense.db

# Supabase Cloud Configuration (Optional - provides Cloud DB, Cloud Storage & Auth)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_BUCKET=invoices

# Storage: "local" or "supabase"
STORAGE_BACKEND=local
UPLOAD_DIR=./data/uploads

# Security & JWT
JWT_SECRET=finsense_jwt_secret_change_in_production_2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# OCR & AI
OCR_ENGINE=auto
OCR_LANGS=en,hi

# FinSense Backend Configuration
APP_NAME=FinSense
DEBUG=false
DATABASE_URL=sqlite:///./finsense.db
# For Supabase Postgres:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Storage Configuration
STORAGE_BACKEND=local
# Set to 'supabase' to enable Supabase Cloud Storage:
# STORAGE_BACKEND=supabase
UPLOAD_DIR=./data/uploads

# Supabase Credentials (from https://supabase.com -> Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET=finsense-files

# CORS & Server
CORS_ORIGINS=["http://localhost:5173"]
TIMEZONE=Asia/Kolkata
